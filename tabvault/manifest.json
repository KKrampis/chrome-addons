{
  "manifest_version": 3,
  "name": "TabVault",
  "version": "1.0.0",
  "description": "Export, sync, and visualize your Chrome tabs and groups. Human-readable format. No account required.",
  "permissions": [
    "tabs",
    "tabGroups",
    "storage",
    "downloads"
  ],
  "host_permissions": [
    "https://api.jsonbin.io/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "chrome_url_overrides": {},
  "web_accessible_resources": [
    {
      "resources": ["pages/tabview.html", "pages/tabview.js", "pages/themes.js"],
      "matches": ["<all_urls>"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
